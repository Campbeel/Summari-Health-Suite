# Copia este archivo a .env y ajusta los valores
# cp .env.example .env   (o en PowerShell: Copy-Item .env.example .env)

# Obligatorias
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/summari
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Servidor
PORT=5000
BASE_URL=http://localhost:5000

# Opcional — IA (transcripción Whisper, GPT, asistente clínico)
# La app arranca sin esto; solo fallan las funciones de IA.
# AI_INTEGRATIONS_OPENAI_API_KEY=sk-...
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
# (también acepta OPENAI_API_KEY)

# Opcional — pagos Flow (sandbox Chile)
# FLOW_BASE_URL=https://sandbox.flow.cl/api
# FLOW_KEY=
# FLOW_SECRET=

# Opcional — email
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# Opcional — Fitbit
# FITBIT_CLIENT_ID=
# FITBIT_CLIENT_SECRET=
